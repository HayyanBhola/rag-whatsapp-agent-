{
  "name": "GlowCare 4 - Overdue case reminders (every 30 min)",
  "nodes": [
    {
      "parameters": {
        "content": "## Overdue cases -> email\nEvery 30 minutes: open cases waiting longer than the target (HIGH: 2 h, NORMAL: 24 h; change with OVERDUE_HOURS_HIGH / OVERDUE_HOURS_NORMAL in .env) get a reminder, repeated at most once per target period until the case is resolved.\n\nResolve a case: `python -m tools.escalations update ESC-12 resolved`\n\n**Edit Config:** email_from, email_to.",
        "height": 300,
        "width": 560
      },
      "id": "e4a7d05c-3c0f-5915-b373-f95ba5b18b85",
      "name": "About",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -320
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      },
      "id": "b3ac3cd5-ba84-5a08-bb5b-f9cb0563f769",
      "name": "Every 30 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        100
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "4be7a914-a161-5af7-9e46-e027376fe28b",
              "name": "api_url",
              "value": "http://127.0.0.1:8000",
              "type": "string"
            },
            {
              "id": "2b594573-aeeb-5fa2-b66c-fc0094bb9b1c",
              "name": "api_key",
              "value": "",
              "type": "string"
            },
            {
              "id": "2b923c78-ff49-5998-a398-39827185757f",
              "name": "email_from",
              "value": "PASTE_YOUR_GMAIL@gmail.com",
              "type": "string"
            },
            {
              "id": "5a8c72af-fd9d-53ab-871e-2e4065fd4e01",
              "name": "email_to",
              "value": "PASTE_WHO_GETS_ALERTS@gmail.com",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "2e338bde-dac6-56cf-b55a-4091a1619021",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        100
      ],
      "notes": "EDIT ME: api_url = where python -m api.server runs; api_key = your GLOWCARE_API_KEY from .env (leave empty if you didn't set one); email_from = your Gmail (the one in the credential); email_to = who gets the alerts (can be the same)",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.api_url }}/alerts/overdue",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $('Config').first().json.api_key }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "32854947-0de1-5625-bf02-c8583aa5bc81",
      "name": "Get overdue cases",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        100
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c16223e5-d874-5db5-9101-e3fee007a71a",
              "leftValue": "={{ $json.count }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "2205a393-84b1-53f2-b9c4-e29ea09e8958",
      "name": "Any overdue?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        100
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "reminders",
        "options": {}
      },
      "id": "e28c7d5c-c76b-570f-b103-bd272f6ac8e2",
      "name": "One item per case",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        880,
        80
      ]
    },
    {
      "parameters": {
        "fromEmail": "={{ $('Config').first().json.email_from }}",
        "toEmail": "={{ $('Config').first().json.email_to }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "html",
        "html": "={{ $json.html }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "2431b572-54dc-5543-9948-e6e8c7281de3",
      "name": "Send email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1100,
        80
      ],
      "credentials": {
        "smtp": {
          "id": "GlowCareGmail",
          "name": "GlowCare Gmail"
        }
      },
      "webhookId": "1dc5fd78-000a-53b4-bb0c-f91533bae242",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.api_url }}/alerts/overdue/{{ $('One item per case').item.json.escalation_id }}/sent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $('Config').first().json.api_key }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "15793a0d-eb22-57b8-89d1-fca5a19ae58b",
      "name": "Mark reminder sent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1340,
        60
      ]
    },
    {
      "parameters": {
        "errorType": "errorMessage",
        "errorMessage": "=The email for {{ $('One item per case').item.json.reference }} could not be sent: {{ $json.error?.message ?? $json.error ?? 'unknown error' }}. Check the Gmail credential (app password) and email_from / email_to in Config. It will be tried again next run."
      },
      "id": "328c048d-a58d-5fee-80b1-77ae1698063e",
      "name": "Email failed",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1340,
        240
      ]
    }
  ],
  "connections": {
