# Copy this file to .env and adjust values for your local PostgreSQL install.
# Nothing here is a real credential — these are local dev defaults.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=glowcare
DB_USER=postgres
DB_PASSWORD=postgres

# --- LLM (Phase 5) ---
# Which LLM answers knowledge-base questions:
#   gemini (free tier) | openai (paid) | ollama (free, local)
LLM_PROVIDER=gemini
# Your key from https://aistudio.google.com/apikey — keep it secret.
GEMINI_API_KEY=paste-your-gemini-key-here
GEMINI_MODEL=gemini-3.1-flash-lite
# Your key from https://platform.openai.com/api-keys — keep it secret,
# never share or upload this .env file.
OPENAI_API_KEY=sk-paste-your-key-here
OPENAI_MODEL=gpt-4o-mini
# Used only when LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:1.5b
