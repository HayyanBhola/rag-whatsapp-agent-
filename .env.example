# Copy this file to .env and adjust values for your local PostgreSQL install.
# Nothing here is a real credential — these are local dev defaults.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=glowcare
DB_USER=postgres
DB_PASSWORD=postgres

# --- LLM (Phase 5) ---
# Which LLM answers knowledge-base questions:
#   gemini (free tier) | openai (paid) | ollama (free, local)
LLM_PROVIDER=gemini
# Your key from https://aistudio.google.com/apikey — keep it secret.
GEMINI_API_KEY=paste-your-gemini-key-here
GEMINI_MODEL=gemini-3.1-flash-lite
# Your key from https://platform.openai.com/api-keys — keep it secret,
# never share or upload this .env file.
OPENAI_API_KEY=sk-paste-your-key-here
OPENAI_MODEL=gpt-4o-mini
# Used only when LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:1.5b

# --- Admin dashboard (Phase 9) ---
# Password for frontend/dashboard.py. Leave empty only on your own computer:
# the dashboard shows customer chats.
DASHBOARD_PASSWORD=

# --- Agent API + n8n (Phase 11) ---
# Where python -m api.server listens. Keep 127.0.0.1: only programs on this
# computer (n8n) can reach it.
API_HOST=127.0.0.1
API_PORT=8000
# Optional. If set, every API call (except /health) must send the header
# X-API-Key with this value: put the same value in api_key in each n8n
# workflow's Config node. Any long random text works.
GLOWCARE_API_KEY=
# Instant alert emails for these priorities and up: high | normal | low
# (low = "I don't have that information"; those are in the daily summary anyway)
ALERT_MIN_PRIORITY=normal
# Hours an open case may wait before a reminder is sent (and between reminders)
OVERDUE_HOURS_HIGH=2
OVERDUE_HOURS_NORMAL=24
# A message after this many quiet hours starts a new chat (outside channels)
SESSION_HOURS=24
